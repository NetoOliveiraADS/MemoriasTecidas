MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 671773622}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07dac60f6bc20224da4c1472e4eafa86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoriasTecidas.MundoV2.MTMPonto
  dados:
    id: npc_andre_lucio
    nome: "Andr\xE9 L\xFAcio"
    tipo: conversa
    destino: 
    evento: andre
    condicao: cruzeiro
    fonte: Falas adaptadas para o jogo.
    falas:
    - "Muita gente conhece hist\xF3rias da Mulher-Cavalo. No relato reunido na pesquisa
      do projeto, ela aparece com corpo humano e cabe\xE7a de cavalo."
    - "Um dos casos fala de um rapaz voltando do circo; outro relato foi contado
      no r\xE1dio. S\xE3o narrativas populares, com vers\xF5es que mudam de pessoa
      para pessoa."
    - "Neste jogo, a lenda ganha uma presen\xE7a perto do rio durante a noite. Voc\xEA
      pode observ\xE1-la e registrar o encontro, sem precisar lutar."
    - "Se quiser esperar a noite, use o banco de descanso da pra\xE7a. Depois siga
      pelo carnaubal at\xE9 a margem do rio."
    x: 5.200001
    y: -11.799999
    chegadaX: 0
    chegadaY: 0
    noturno: 0
  retrato: {fileID: 2800000, guid: a1142dc8bc96f474bb8859c22688972b, type: 3}
  recorteRosto:
    serializedVersion: 2
    x: 0.26866916
    y: 0.61691403
    width: 0.46266168
    height: 0.34858072
  alcance: 1.45
