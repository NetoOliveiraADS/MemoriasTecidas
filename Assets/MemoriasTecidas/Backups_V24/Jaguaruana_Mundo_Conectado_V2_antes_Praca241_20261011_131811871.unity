      falas: []
      x: 44
      y: -6
      chegadaX: -15.299999
      chegadaY: 25.7
      noturno: 0
    - id: largo_calcadas
      nome: "Hist\xF3rias de cal\xE7ada"
      tipo: conversa
      destino: 
      evento: largo_calcadas
      condicao: 
      fonte: "Texto autoral para o jogo. Cen\xE1rio inspirado nas refer\xEAncias
        enviadas; dist\xE2ncias e disposi\xE7\xE3o adaptadas."
      falas:
      - "H\xE1 mem\xF3rias nas conversas de cal\xE7ada e nos caminhos repetidos todos
        os dias."
      - "Que mudan\xE7a neste lugar voc\xEA gostaria de registrar?"
      x: -33
