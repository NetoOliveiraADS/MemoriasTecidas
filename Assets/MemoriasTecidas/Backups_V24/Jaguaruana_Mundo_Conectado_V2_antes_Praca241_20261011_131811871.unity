    pontos:
    - id: npc_zeca
      nome: "Zeca \xB7 morador"
      tipo: conversa
      destino: 
      evento: zeca
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas:
      - "Sou Zeca. Esta rua foi imaginada para a aventura: lojas, oficinas e casas
        ajudam a mostrar como o trabalho se mistura \xE0 vida cotidiana."
      - "Olhe as fachadas, os varais e os materiais das bancas. Voc\xEA tamb\xE9m
        pode conhecer a Vila das Tecel\xE3s pelo carnaubal."
      x: -7.999999
      y: -1.9599992
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: rua_oficios
      nome: "Ler sobre os of\xEDcios"
      tipo: conversa
      destino: 
      evento: rua_oficios
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas:
      - "Uma oficina n\xE3o se resume a uma ferramenta. O saber passa entre pessoas,
        gestos e lembran\xE7as."
      - "As fachadas desta rua s\xE3o cria\xE7\xF5es art\xEDsticas inspiradas na
        arquitetura da regi\xE3o."
      x: 4.200001
      y: 1.2000008
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: rua_para_praca
      nome: "Pra\xE7a Matriz"
      tipo: saida
      destino: praca
      evento: 
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas: []
      x: -36.8
      y: -4.799999
      chegadaX: 15.700001
      chegadaY: 25.7
      noturno: 0
    - id: rua_para_mercado
      nome: "Mercado P\xFAblico"
      tipo: saida
      destino: mercado
      evento: 
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas: []
      x: 37.2
      y: -4.799999
      chegadaX: -33.017586
      chegadaY: 6.840172
      noturno: 0
    - id: rua_expositor
      nome: "Mostru\xE1rio de redes"
      tipo: conversa
      destino: 
      evento: rua_expositor
      condicao: 
      fonte: "Cena e atividade fict\xEDcias criadas para Mem\xF3rias Tecidas; n\xE3o
        \xE9 cita\xE7\xE3o hist\xF3rica."
      falas:
      - "O mostru\xE1rio aproxima o trabalho da oficina de quem passa pela rua."
      - "Cores, acabamentos e modos de uso tamb\xE9m contam hist\xF3rias. Converse
        com Zeca e depois conhe\xE7a os quintais da vila."
      x: 16.2
      y: -0.79999924
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: npc_v23_feirante
      nome: "Sueli \xB7 feirante (fic\xE7\xE3o)"
      tipo: conversa
      destino: 
      evento: v23_feirante
      condicao: 
      fonte: "Personagem e falas ficcionais criados para o jogo. N\xE3o representam
        depoimento de uma pessoa real."
      falas:
      - Bom dia! Sou Sueli, uma feirante criada para este jogo.
      - Olhe os caixotes, os toldos e as fachadas. A rua foi inspirada em fotografias
        de Jaguaruana.
      - "Mais adiante h\xE1 redes expostas. Converse com Zeca para conhecer os of\xEDcios
        presentes nesta aventura."
      x: -14.799999
      y: -0.79999924
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    agua: []
