  m_EditorClassIdentifier: Assembly-CSharp::MemoriasTecidas.MundoV2.MTMPonto
  dados:
    id: npc_v23_barraqueiro
    nome: "Ti\xE3o \xB7 barraqueiro (fic\xE7\xE3o)"
    tipo: conversa
    destino: 
    evento: v23_barraqueiro
    condicao: 
    fonte: "Personagem e falas ficcionais criados para o jogo. N\xE3o representam
      depoimento de uma pessoa real."
    falas:
    - "Sou Ti\xE3o, um barraqueiro fict\xEDcio desta aventura. Seja bem-vindo \xE0
      beira do rio!"
    - "Estas barracas e sombras de \xE1rvores foram inspiradas nas imagens do lugar.
      A disposi\xE7\xE3o foi adaptada ao jogo."
    - "Voc\xEA pode seguir pelo cal\xE7amento para visitar o trecho do Rio Serafim
      / Jaguaribe. \xC0 noite, volte a conversar com Andr\xE9 L\xFAcio na pra\xE7a
      para ouvir seu relato."
    x: -14.799999
    y: -9.799999
    chegadaX: 0
    chegadaY: 0
    noturno: 0
  retrato: {fileID: 2800000, guid: 4e888c5934899704293f0749b6ce56f5, type: 3}
