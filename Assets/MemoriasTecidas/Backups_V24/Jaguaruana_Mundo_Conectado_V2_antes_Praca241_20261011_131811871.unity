  dados:
    id: v24_fachada_prefeitura
    nome: "Mem\xF3rias da cidade"
    tipo: conversa
    destino: 
    evento: v24_v24_fachada_prefeitura
    condicao: 
    fonte: "Texto autoral para o jogo. Cen\xE1rio inspirado nas refer\xEAncias enviadas;
      dist\xE2ncias e disposi\xE7\xE3o adaptadas."
    falas:
    - "Uma cidade re\xFAne muitas hist\xF3rias: nos documentos, nas fotografias e
      nas lembran\xE7as de seus moradores."
    - "Compare aquilo que voc\xEA v\xEA com o que as pessoas contam. Cada registro
      pode revelar outro detalhe."
    x: 24
    y: 11.8
    chegadaX: 0
    chegadaY: 0
    noturno: 0
  retrato: {fileID: 0}
  recorteRosto:
    serializedVersion: 2
    x: 0
    y: 0
    width: 1
    height: 1
  alcance: 1.45
