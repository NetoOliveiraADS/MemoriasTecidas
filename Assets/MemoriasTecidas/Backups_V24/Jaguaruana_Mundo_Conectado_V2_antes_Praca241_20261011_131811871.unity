    pontos:
    - id: npc_artesa
      nome: "Rosa \xB7 artes\xE3"
      tipo: conversa
      destino: 
      evento: fiar
      condicao: 
      fonte: "Personagem fict\xEDcio."
      falas:
      - "Voc\xEA trouxe o algod\xE3o. Na produ\xE7\xE3o real, \xE9 preciso preparar
        as fibras antes de obter o fio."
      - "Vamos representar essa prepara\xE7\xE3o de forma simples: seis algod\xF5es
        se transformam em tr\xEAs conjuntos de fios."
      - "Confirme para guardar os fios. Depois, use o tear \xE0 direita quando tiver
        todos os materiais."
      x: -2.4
      y: -1.8000001
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: estacao_tear
      nome: Montar sua rede
      tipo: conversa
      destino: 
      evento: tecer
      condicao: 
      fonte: "Sequ\xEAncia textual de produ\xE7\xE3o; receita did\xE1tica simplificada."
      falas:
      - "Separe os fios, a corda, o pano, os punhos e o enfeite. Esta sequ\xEAncia
        resume o processo para a atividade do jogo."
      - "Primeiro, organize os fios e acompanhe o entrela\xE7ar da trama. Depois,
        re\xFAna o pano e prepare os punhos."
      - "Agora confira as amarra\xE7\xF5es e coloque o enfeite. A qualidade do trabalho
        vem da aten\xE7\xE3o a cada etapa."
      - "Confirme para concluir sua rede e guardar a lembran\xE7a na bolsa. Depois,
        mostre o resultado a Neto."
      x: 7.2000003
      y: 0.24000001
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: oficina_para_fabrica
      nome: "P\xE1tio da f\xE1brica"
      tipo: saida
      destino: fabrica
      evento: 
      condicao: 
      fonte: 
      falas: []
      x: -0.050001144
      y: -8.650001
      chegadaX: -0.15000153
      chegadaY: -4.1500015
      noturno: 0
    agua: []
  pontos:
  - {fileID: 535087678}
  - {fileID: 1557139058}
  - {fileID: 1375629094}
  aparicoes: []
