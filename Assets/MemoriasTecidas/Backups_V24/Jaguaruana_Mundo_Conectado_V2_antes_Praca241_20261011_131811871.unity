      y: 11.8
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: v24_praca_prefeitura
      nome: "Uma pra\xE7a de encontros"
      tipo: conversa
      destino: 
      evento: v24_v24_praca_prefeitura
      condicao: 
      fonte: "Texto autoral para o jogo. Cen\xE1rio inspirado nas refer\xEAncias
        enviadas; dist\xE2ncias e disposi\xE7\xE3o adaptadas."
      falas:
      - "Fa\xE7a uma pausa. Bancos, \xE1rvores e caminhos aproximam quem passa pela
        pra\xE7a."
      - "Depois, siga at\xE9 o Mercado P\xFAblico para continuar os encontros da
        sua jornada."
      x: 8
      y: -2.2
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: v24_descanso_prefeitura
