    pontos:
    - id: largo_encontros
      nome: "Largo da Vila \xB7 Ponta da Rua"
      tipo: conversa
      destino: 
      evento: largo_encontros
      condicao: 
      fonte: "Texto autoral para o jogo. Cen\xE1rio inspirado nas refer\xEAncias
        enviadas; dist\xE2ncias e disposi\xE7\xE3o adaptadas."
      falas:
      - "As cal\xE7adas, as fachadas e o canteiro ajudam a reconhecer este trecho
        da cidade."
      - "Caminhe entre os quarteir\xF5es e procure um lugar \xE0 sombra para observar
        a rua."
      x: 0
      y: -4
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: largo_para_entrada
      nome: Entrada da cidade
      tipo: saida
      destino: entrada
