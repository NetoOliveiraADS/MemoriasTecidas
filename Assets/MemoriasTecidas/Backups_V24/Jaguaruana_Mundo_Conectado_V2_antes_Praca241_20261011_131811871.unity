  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoriasTecidas.MundoV2.MTMPonto
  dados:
    id: peca_museu
    nome: "Pe\xE7a de palha do acervo"
    tipo: conversa
    destino: 
    evento: museu
    condicao: guia_museu
    fonte: "Exposi\xE7\xE3o interpretativa criada para o jogo."
    falas:
    - "Voc\xEA observa o tran\xE7ado de uma pe\xE7a de palha. O objeto permanece
      no acervo."
    - "Lia registra a visita e entrega uma amostra simb\xF3lica de cera de carna\xFAba
      para a bolsa. Ela \xE9 uma lembran\xE7a deste aprendizado."
    x: 7.2000003
    y: 0.36
    chegadaX: 0
    chegadaY: 0
    noturno: 0
  retrato: {fileID: 0}
  recorteRosto:
    serializedVersion: 2
    x: 0
    y: 0
    width: 1
    height: 1
  alcance: 1.45
