    pontos:
    - id: paisagem_beira
      nome: Pausa na Beira-Rio
      tipo: conversa
      destino: 
      evento: paisagem_beira
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas:
      - As canoas, a sombra e a margem criam outro ritmo para a caminhada.
      - "Este passeio \xE9 uma composi\xE7\xE3o fict\xEDcia inspirada na rela\xE7\xE3o
        da cidade com o rio. As canoas s\xE3o decorativas; n\xE3o existe navega\xE7\xE3o
        nesta vers\xE3o."
      x: 0.20000076
      y: 5.200001
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: beira_para_vila
      nome: "Vila das Tecel\xE3s"
      tipo: saida
      destino: vila
      evento: 
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas: []
      x: -28.8
      y: -15.799999
      chegadaX: 32.75
      chegadaY: -5.950001
      noturno: 0
    - id: beira_para_rio
      nome: Rio Serafim / Jaguaribe
      tipo: saida
      destino: rio
      evento: 
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas: []
      x: 0.20000076
      y: 21.2
      chegadaX: 0.20000076
      chegadaY: -20.3
      noturno: 0
    - id: beira_canoas
      nome: Canto das canoas
      tipo: conversa
      destino: 
      evento: beira_canoas
      condicao: 
      fonte: "Cena e atividade fict\xEDcias criadas para Mem\xF3rias Tecidas; n\xE3o
        \xE9 cita\xE7\xE3o hist\xF3rica."
      falas:
      - "As canoas descansam junto \xE0 margem nesta cena da aventura."
      - "Repare na mudan\xE7a do ch\xE3o, na sombra das palmeiras e na dist\xE2ncia
        entre o passeio e a \xE1gua."
      x: -8.799999
      y: 3.2000008
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: npc_v23_barraqueiro
      nome: "Ti\xE3o \xB7 barraqueiro (fic\xE7\xE3o)"
      tipo: conversa
      destino: 
      evento: v23_barraqueiro
      condicao: 
      fonte: "Personagem e falas ficcionais criados para o jogo. N\xE3o representam
        depoimento de uma pessoa real."
      falas:
      - "Sou Ti\xE3o, um barraqueiro fict\xEDcio desta aventura. Seja bem-vindo \xE0
        beira do rio!"
      - "Estas barracas e sombras de \xE1rvores foram inspiradas nas imagens do lugar.
        A disposi\xE7\xE3o foi adaptada ao jogo."
      - "Voc\xEA pode seguir pelo cal\xE7amento para visitar o trecho do Rio Serafim
        / Jaguaribe. \xC0 noite, volte a conversar com Andr\xE9 L\xFAcio na pra\xE7a
        para ouvir seu relato."
      x: -14.799999
      y: -9.799999
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    agua: []
