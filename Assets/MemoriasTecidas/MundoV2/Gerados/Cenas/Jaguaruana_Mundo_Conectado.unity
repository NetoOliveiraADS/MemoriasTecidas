    pontos:
    - id: largo_encontros
      nome: Lugar de encontros
      tipo: conversa
      destino: 
      evento: largo_encontros
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas:
      - "Um largo pode reunir uma conversa, uma pausa e uma celebra\xE7\xE3o."
      - "Este cen\xE1rio amplia os espa\xE7os cotidianos da aventura. Uma festa poder\xE1
        ser acrescentada depois que a jornada principal estiver conclu\xEDda."
