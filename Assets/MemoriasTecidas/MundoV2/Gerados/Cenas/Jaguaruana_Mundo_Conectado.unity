    pontos:
    - id: npc_cida
      nome: "Dona Cida \xB7 moradora"
      tipo: conversa
      destino: 
      evento: cida
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas:
      - "Sou Cida. Gosto de cuidar das plantas e de conversar na cal\xE7ada enquanto
        o trabalho descansa um pouco."
      - "Esta vila foi criada para o jogo. As redes nos quintais e as oficinas lembram
        que a produ\xE7\xE3o tamb\xE9m faz parte das casas e das fam\xEDlias."
      x: -1.4
      y: 0.1
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: varais_vila
      nome: Observar os varais
      tipo: conversa
      destino: 
      evento: varais_vila
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas:
      - "Os varais transformam o quintal em um lugar de trabalho e conviv\xEAncia."
      - "Observe as redes e o tear. Para preparar os fios da sua encomenda, procure
        Rosa na oficina da f\xE1brica."
      x: 0.7
      y: 4.4
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: jardins_vila
      nome: Conhecer os quintais
      tipo: conversa
      destino: 
      evento: jardins_vila
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas:
      - "Os quintais d\xE3o lugar a plantas, encontros e pequenas tarefas."
      - "A vila \xE9 uma cria\xE7\xE3o da aventura, sem pretender reproduzir um endere\xE7o
        espec\xEDfico."
      x: 25
      y: 7.7
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: vila_para_carnaubal
      nome: Carnaubal
      tipo: saida
      destino: carnaubal
      evento: 
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas: []
      x: -29.4
      y: -6
      chegadaX: -19.2
      chegadaY: 3
      noturno: 0
    - id: vila_para_beira
      nome: Beira-Rio
      tipo: saida
      destino: beira
      evento: 
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas: []
      x: 29.4
      y: -5
      chegadaX: -19.2
      chegadaY: -10
      noturno: 0
    - id: tear_quintal
      nome: Tear do quintal
      tipo: conversa
      destino: 
      evento: tear_quintal
      condicao: 
      fonte: "Cena e atividade fict\xEDcias criadas para Mem\xF3rias Tecidas; n\xE3o
        \xE9 cita\xE7\xE3o hist\xF3rica."
      falas:
      - "O tear ocupa um canto protegido, perto dos fios e das pe\xE7as em exposi\xE7\xE3o."
      - "Este \xE9 um lugar de observa\xE7\xE3o. Rosa acompanha a prepara\xE7\xE3o
        da sua rede na oficina da f\xE1brica."
      x: -4.5
      y: 1.8
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    agua: []
