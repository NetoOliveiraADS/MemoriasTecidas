  dados:
    id: npc_guia
    nome: "Lia \xB7 guia do memorial"
    tipo: conversa
    destino: 
    evento: guia_museu
    condicao: 
    fonte: "Personagem fict\xEDcio."
    falas:
    - "Bem-vindo! Este espa\xE7o do jogo foi criado para apresentar a carna\xFAba
      e as mem\xF3rias do trabalho ligado a ela."
    - "Examine a pe\xE7a de palha na exposi\xE7\xE3o \xE0 direita. A cera e o artesanato
      ajudam a mostrar diferentes usos dessa palmeira."
    x: 0
    y: -1.6
    chegadaX: 0
    chegadaY: 0
    noturno: 0
