  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoriasTecidas.MundoV2.MTMPonto
  dados:
    id: npc_neto
    nome: Neto
    tipo: conversa
    destino: 
    evento: neto
    condicao: 
    fonte: Falas adaptadas para o jogo.
    falas:
    - "Bem-vindo a Mem\xF3rias Tecidas! Vamos conhecer Jaguaruana pelos lugares,
      pelas pessoas e pelo trabalho de fazer uma rede."
    - "Alguns encontros s\xE3o mem\xF3rias de outras \xE9pocas. Comece conversando
      com Dona Feliciana e Sim\xE3o de G\xF3is aqui na pra\xE7a."
    - "Quando precisar de orienta\xE7\xE3o, abra o mapa com M. As sa\xEDdas t\xEAm
      o nome do lugar: aproxime-se e pressione E."
    x: -1.6
    y: -3.6
    chegadaX: 0
    chegadaY: 0
    noturno: 0
  retrato: {fileID: 2800000, guid: b14ac975a36ee294c94f73dcf590e9bd, type: 3}
