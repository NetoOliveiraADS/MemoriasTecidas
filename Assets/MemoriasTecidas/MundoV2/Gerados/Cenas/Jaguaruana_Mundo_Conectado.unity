    - nome: 
      arte: banca
      x: 11
      y: -3.5
      escala: 0.8
      semColisao: 0
      noturno: 0
    - nome: "Mestre Gerardinho \xB7 mem\xF3ria"
      arte: gerardinho
      x: -8
      y: 0.5
      escala: 1
      semColisao: 0
      noturno: 0
    - nome: "Ivonete Maia \xB7 mem\xF3ria"
      arte: ivonete
      x: 0
      y: 0.5
      escala: 1
      semColisao: 0
      noturno: 0
    - nome: "Em\xEDlia Freitas \xB7 mem\xF3ria"
      arte: emilia
      x: 8
      y: 0.5
