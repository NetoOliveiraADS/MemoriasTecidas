    - nome: Rede_Modelo_Da_Oficina
      arte: rede_pronta
      x: -8
      y: -3.9
      escala: 1
      semColisao: 0
      noturno: 0
    - nome: "Rosa \xB7 artes\xE3"
      arte: artesa
      x: -2
      y: -1.5
      escala: 1
      semColisao: 0
      noturno: 0
    - nome: 
      arte: caixotes
      x: -11
      y: -2
      escala: 0.8
      semColisao: 0
