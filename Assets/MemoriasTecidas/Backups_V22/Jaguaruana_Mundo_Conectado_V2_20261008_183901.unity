  dados:
    id: npc_zeca
    nome: "Zeca \xB7 morador"
    tipo: conversa
    destino: 
    evento: zeca
    condicao: 
    fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
    falas:
    - "Sou Zeca. Esta rua foi imaginada para a aventura: lojas, oficinas e casas
      ajudam a mostrar como o trabalho se mistura \xE0 vida cotidiana."
    - "Olhe as fachadas, os varais e os materiais das bancas. Voc\xEA tamb\xE9m pode
      conhecer a Vila das Tecel\xE3s pelo carnaubal."
    x: 1
    y: -0.7
    chegadaX: 0
    chegadaY: 0
    noturno: 0
