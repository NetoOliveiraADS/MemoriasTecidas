    pontos:
    - id: visita_cruzeiro
      nome: Visitar o Cruzeiro
      tipo: conversa
      destino: 
      evento: cruzeiro
      condicao: simao
      fonte: "Fonte hist\xF3rica: Prefeitura de Jaguaruana. Recompensa fict\xEDcia."
      falas:
      - "No alto da Serra Dantas, o Cruzeiro lembra pr\xE1ticas de f\xE9 e encontros
        da comunidade. A missa de Cristo Rei \xE9 uma tradi\xE7\xE3o registrada pelo
        munic\xEDpio."
      - "Voc\xEA registra o lugar no di\xE1rio. Para a jornada do jogo, recebe corda
        e pano que ser\xE3o usados na oficina."
      - "Volte \xE0 pra\xE7a para ouvir Andr\xE9 L\xFAcio. O mapa ajuda a encontrar
        o caminho de retorno."
      x: 0
      y: -0.2
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: mirante
      nome: Olhar a paisagem
      tipo: conversa
      destino: 
      evento: mirante
      condicao: 
      fonte: 
      falas:
      - "A trilha d\xE1 lugar a uma pausa. As pedras, a vegeta\xE7\xE3o e os caminhos
        tamb\xE9m guardam mem\xF3rias."
      - "Este cen\xE1rio \xE9 uma interpreta\xE7\xE3o visual das fotos da Serra Dantas
        enviadas ao projeto."
      x: -7
      y: -3.6
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: serra_para_sitio
      nome: "S\xEDtio do Algod\xE3o"
