  dados:
    id: npc_padre_duceu
    nome: "Padre Duc\xE9u \xB7 mem\xF3ria"
    tipo: conversa
    destino: 
    evento: padre_duceu
    condicao: 
    fonte: "Encontro de mem\xF3ria \xB7 falas adaptadas."
    falas:
    - "Esta \xE9 uma representa\xE7\xE3o de mem\xF3ria do Padre Raimundo Sales Fa\xE7anha,
      conhecido como Padre Duc\xE9u."
    - "As festas e celebra\xE7\xF5es tamb\xE9m ajudam a contar a hist\xF3ria de uma
      comunidade. Observe os lugares onde as pessoas se encontram."
    - "No di\xE1rio, guarde a lembran\xE7a deste encontro. A festa da pra\xE7a pode
      ser o pr\xF3ximo cap\xEDtulo da aventura."
    x: -3.5
    y: 4.4
    chegadaX: 0
    chegadaY: 0
    noturno: 0
