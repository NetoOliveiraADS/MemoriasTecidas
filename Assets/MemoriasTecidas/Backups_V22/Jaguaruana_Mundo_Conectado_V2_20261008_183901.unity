      evento: pacote3
      condicao: 
      fonte: "Atividade fict\xEDcia inspirada no roteiro enviado."
      falas:
      - "Voc\xEA conferiu a encomenda desta banca."
      - "Depois de verificar as tr\xEAs bancas, converse com Seu Bento."
      x: 6
      y: -3
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: npc_feirante
      nome: Seu Bento
      tipo: conversa
      destino: 
      evento: mercado_entrega
      condicao: 
      fonte: "Personagem fict\xEDcio."
      falas:
      - "Obrigado por conferir as tr\xEAs encomendas. Aqui est\xE3o os punhos para
        sua rede."
      - "O trabalho passa por muitas m\xE3os. Na oficina, Rosa vai ajudar voc\xEA
        com os fios e o tear."
      x: -2
      y: -0.2
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: npc_raimundo
      nome: "Raimundo Jaguaribe \xB7 mem\xF3ria"
      tipo: conversa
      destino: 
      evento: raimundo
      condicao: 
      fonte: "Encontro de mem\xF3ria \xB7 falas adaptadas."
      falas:
      - "Uma mem\xF3ria de Raimundo Francisco Freitas Jaguaribe, nome ligado \xE0
        vida p\xFAblica de Jaguaruana."
      - "Ao observar uma cidade, procure conhecer as decis\xF5es e as pessoas que
        transformaram seus espa\xE7os. Escute diferentes vers\xF5es e compare os
        registros."
      x: 13
      y: 3.8
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: mercado_para_praca
      nome: "Pra\xE7a Matriz"
      tipo: saida
      destino: praca
      evento: 
      condicao: 
      fonte: 
      falas: []
      x: -21.4
      y: -6
      chegadaX: 19.2
      chegadaY: -6
      noturno: 0
    - id: mercado_para_fabrica
      nome: "P\xE1tio da f\xE1brica"
      tipo: saida
      destino: fabrica
      evento: 
      condicao: 
      fonte: 
      falas: []
      x: 21.4
      y: -6
      chegadaX: -19.2
      chegadaY: -5.5
      noturno: 0
    - id: mercado_para_rua
      nome: "Rua do Com\xE9rcio"
      tipo: saida
      destino: rua
      evento: 
      condicao: 
      fonte: "Espa\xE7o e atividade fict\xEDcios criados para o jogo."
      falas: []
      x: 21.4
      y: 7
      chegadaX: 27.2
      chegadaY: -4
      noturno: 0
    - id: patio_cargas
      nome: "P\xE1tio das encomendas"
      tipo: conversa
      destino: 
      evento: patio_cargas
      condicao: 
      fonte: "Cena e atividade fict\xEDcias criadas para Mem\xF3rias Tecidas; n\xE3o
        \xE9 cita\xE7\xE3o hist\xF3rica."
      falas:
      - "Neste p\xE1tio da aventura, materiais chegam, s\xE3o separados e seguem
        para as bancas."
      - "O lugar ajuda a perceber o caminho entre a produ\xE7\xE3o, a venda e o uso
        de uma pe\xE7a."
      x: -15
      y: 4.4
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    agua: []
