  dados:
    id: oficina
    nome: Oficina de redes
    descricao: "Fiar o algod\xE3o, aprender sobre a produ\xE7\xE3o e usar o tear."
    piso: piso_interior
    interior: 1
    mapaX: 3
    mapaY: 0
