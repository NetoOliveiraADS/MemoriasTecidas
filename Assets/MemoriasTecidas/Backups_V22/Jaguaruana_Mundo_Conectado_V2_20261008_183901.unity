      tipo: conversa
      destino: 
      evento: gerardinho
      condicao: 
      fonte: "Encontro de mem\xF3ria \xB7 falas adaptadas."
      falas:
      - "Uma mem\xF3ria do professor Gerardo Correia Lima, lembrado como Mestre Gerardinho."
      - "Relatos locais recordam seu trabalho na educa\xE7\xE3o. Aprender a ouvir
        quem veio antes tamb\xE9m \xE9 uma forma de aprender sobre a cidade."
      x: -8
      y: 0.5
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: npc_ivonete
      nome: "Ivonete Maia \xB7 mem\xF3ria"
      tipo: conversa
      destino: 
      evento: ivonete
      condicao: 
      fonte: "Encontro de mem\xF3ria \xB7 falas adaptadas."
      falas:
      - "Uma mem\xF3ria de Ivonete Maia, jornalista e educadora ligada \xE0 hist\xF3ria
        da imprensa cearense."
      - "Escutar uma hist\xF3ria \xE9 um come\xE7o. Anote de onde ela veio, procure
        outros registros e preserve tamb\xE9m as diferen\xE7as entre as vers\xF5es."
      x: 0
      y: 0.5
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: npc_emilia
      nome: "Em\xEDlia Freitas \xB7 mem\xF3ria"
      tipo: conversa
      destino: 
      evento: emilia
      condicao: 
      fonte: "Encontro de mem\xF3ria \xB7 falas adaptadas."
      falas:
      - "Uma mem\xF3ria da escritora Em\xEDlia Freitas, autora de A Rainha do Ignoto,
        publicado em 1899."
      - "A imagina\xE7\xE3o cria lugares e possibilidades. Que hist\xF3ria voc\xEA
        levaria de Jaguaruana para escrever depois desta aventura?"
      x: 8
      y: 0.5
      chegadaX: 0
      chegadaY: 0
      noturno: 0
    - id: memorias_para_praca
      nome: "Pra\xE7a Matriz"
      tipo: saida
      destino: praca
      evento: 
      condicao: 
      fonte: 
      falas: []
      x: 0
      y: -7.3
      chegadaX: 9
      chegadaY: 4.8
      noturno: 0
    agua: []
