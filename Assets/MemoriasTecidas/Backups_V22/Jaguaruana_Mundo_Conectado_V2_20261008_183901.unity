  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07dac60f6bc20224da4c1472e4eafa86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoriasTecidas.MundoV2.MTMPonto
  dados:
    id: estacao_tear
    nome: Montar sua rede
    tipo: conversa
    destino: 
    evento: tecer
    condicao: 
    fonte: "Sequ\xEAncia textual de produ\xE7\xE3o; receita did\xE1tica simplificada."
    falas:
    - "Separe os fios, a corda, o pano, os punhos e o enfeite. Esta sequ\xEAncia
      resume o processo para a atividade do jogo."
    - "Primeiro, organize os fios e acompanhe o entrela\xE7ar da trama. Depois, re\xFAna
      o pano e prepare os punhos."
    - "Agora confira as amarra\xE7\xF5es e coloque o enfeite. A qualidade do trabalho
      vem da aten\xE7\xE3o a cada etapa."
    - "Confirme para concluir sua rede e guardar a lembran\xE7a na bolsa. Depois,
      mostre o resultado a Neto."
    x: 6
    y: 0.2
    chegadaX: 0
    chegadaY: 0
    noturno: 0
  retrato: {fileID: 0}
  recorteRosto:
    serializedVersion: 2
    x: 0
    y: 0
    width: 1
    height: 1
  alcance: 1.45
